{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -File {{PROJECT_PATH}}/.claude/hooks/session-start.ps1"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -File {{PROJECT_PATH}}/.claude/hooks/pre-bash-git-guard.ps1"
          },
          {
            "type": "command",
            "command": "powershell -NoProfile -File {{PROJECT_PATH}}/.claude/hooks/pre-commit-antipattern.ps1"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -File {{PROJECT_PATH}}/.claude/hooks/pre-config-protection.ps1"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash {{PROJECT_PATH_FWD}}/.claude/hooks/post-commit-journal.sh"
          }
        ]
      }
    ]
  }
}
